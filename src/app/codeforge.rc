// CodeForge Windows resources: embedded version information (shown in
// Explorer properties, UAC prompts, and used by SmartScreen reputation
// services) + application icon + manifest.
//
// NOTE: keep FILEVERSION/PRODUCTVERSION in sync with CMakeLists PROJECT_VERSION.
#include <windows.h>

1 ICON "codeforge.ico"

// NOTE: the application manifest is embedded by mt.exe in a POST_BUILD step
// (canonical Visual Studio path). Embedding it here as `1 24` produced an
// activation context Windows rejected ("side-by-side configuration is
// incorrect") at process start.

1 VERSIONINFO
FILEVERSION     1,2,1,0
PRODUCTVERSION  1,2,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "CodeForge Project"
            VALUE "FileDescription",  "CodeForge - lightweight native code editor"
            VALUE "FileVersion",      "1.2.1.0"
            VALUE "InternalName",     "CodeForge"
            VALUE "LegalCopyright",   "MIT License. Copyright (C) CodeForge Project."
            VALUE "OriginalFilename", "CodeForge.exe"
            VALUE "ProductName",      "CodeForge"
            VALUE "ProductVersion",   "1.2.1.0"
            VALUE "LegalTrademarks",  ""
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200   // English (US), Unicode
    END
END
